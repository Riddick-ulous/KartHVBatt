		(uuid "17e35cb0-09b6-42c2-a960-9232d5d9731e")
	)
	(text_box "AMC INPUT LOW-PASS\n\nR_TH = R_TOP || R_SNS\nR_TH = 9.4 MOhm || 26.1 kOhm\nR_TH approx. 26.03 kOhm\n\nC_IN = C2004 = 100 pF\n\ntau_IN = R_TH * C_IN\ntau_IN approx. 2.60 us\n\nf_c,IN = 1 / (2 * pi * R_TH * C_IN)\nf_c,IN approx. 61.1 kHz\n\nt_10-90,IN approx. 2.2 * tau_IN\nt_10-90,IN approx. 5.7 us\n\nAMC OUTPUT / ADC LOW-PASS\n\nR_OUT = R2008 = 1.0 kOhm\nC_OUT = C2014 = 1.0 nF\n\ntau_OUT = R_OUT * C_OUT\ntau_OUT = 1.0 us\n\nf_c,OUT = 1 / (2 * pi * R_OUT * C_OUT)\nf_c,OUT approx. 159 kHz\n\nt_10-90,OUT approx. 2.2 * tau_OUT\nt_10-90,OUT approx. 2.2 us"
		(exclude_from_sim no)
		(at 180.34 109.3173 0)
		(size 27.94 40.5427)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
			(color 0 0 0 1)
		)
		(fill
			(type color)
			(color 255 255 194 1)
		)
		(effects
			(font
				(size 0.8 0.8)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "1af98cc6-50af-43c4-b499-69d794c89b79")
	)
	(text_box "PRECHARGE 90 % CHECK / HARDWARE CLAMP\n\nV_ACCU and V_VEHI are nominally equally scaled\nisolated HV measurements.\n\n90 % reference divider:\n\nR_SER = 100 kOhm\nR_GND = 909 kOhm\n\nk_90 = R_GND / (R_SER + R_GND)\nk_90 = 909 k / (100 k + 909 k)\nk_90 = 0.900892\n\nV_ACCU_90 = k_90 * V_ACCU\n\n\nPRCHG_DONE:\n\nIN+ = V_VEHI\nIN- = V_ACCU_90\n\nV_VEHI < V_ACCU_90:\nOutput actively LOW\nHardware clamp active / AIR_P blocked\n\nV_VEHI > V_ACCU_90:\nOutput HIGH-Z / released\n\nPRCHG_DONE has no local pull-up.\nIt is a hardware clamp only and is not an MCU logic high.\n\n\nnPRCHG_DONE:\n\nIN+ = V_ACCU_90\nIN- = V_VEHI\nOutput pull-up = 10 kOhm to 3.3 V\n\nV_VEHI < V_ACCU_90:\nnPRCHG_DONE = HIGH\n\nV_VEHI > V_ACCU_90:\nnPRCHG_DONE = LOW\n\n\nAIR_P INTERLOCK:\n\nPRCHG_DONE may only inhibit / clamp AIR_P.\nThe comparator cannot request or enable AIR_P.\n\nFirmware shall close AIR_P only after:\n\nV_VEHI >= 0.95 * V_ACCU\n\nwith debounce and valid HV measurement channels.\n\nNominal hardware release threshold: 90.1 %\n\nThe actual switching threshold is affected by:\n- divider tolerances\n- AMC gain and offset mismatch\n- comparator offset and hysteresis\n\nThis circuit is a supplementary plausibility interlock,\nnot a precision or independent safety measurement."
		(exclude_from_sim no)
		(at 341.63 141.6909 0)
		(size 39.37 86.9091)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
			(color 0 0 0 1)
		)
		(fill
			(type color)
			(color 255 255 194 1)
		)
		(effects
			(font
				(size 0.8 0.8)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "3f7563a1-97b5-4394-98ee-cb623f7d6f7f")
	)
	(text_box "4.4mm creepage per R for 2512 inch package"
