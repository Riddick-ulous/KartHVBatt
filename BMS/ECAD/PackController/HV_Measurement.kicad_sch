	)
	(text_box "DANGER VOLTAGE THRESHOLD: APPROX. 50 V\n\nHV measurement transfer:\n\nR_TOP = 4.7 MOhm + 4.7 MOhm = 9.4 MOhm\nR_SNS = 26.1 kOhm\n\nk_DIV = 26.1 k / (9.4 M + 26.1 k)\nk_DIV = 0.00276891\n\nAMC0311R:\nV_OUT = V_HV * k_DIV * V_REFIN / 2.56 V\n\nWith V_REFIN = 3.3 V:\n\nV_OUT = V_HV * 0.00356930\n\nV_OUT @ 50 V = 178.46 mV\n\n\nComparator threshold reference:\n\nR_REF_HIGH = 68.1 kOhm\nR_REF_LOW  = 3.90 kOhm\n\nV_DANGER_REF =\n3.3 V * 3.90 k / (68.1 k + 3.90 k)\n\nV_DANGER_REF = 178.75 mV\n\nNominal HV threshold:\n\nV_HV,TH = 178.75 mV / 0.00356930\nV_HV,TH = 50.08 V\n\n\nDANGER_V:\nIN+ = V_VEHI\nIN- = V_DANGER_REF\nOutput released when V_HV > approx. 50 V\n\nnDANGER_V:\nIN+ = V_DANGER_REF\nIN- = V_VEHI\nOutput LOW when V_HV > approx. 50 V"
		(exclude_from_sim no)
		(at 342.9 53.9187 0)
		(size 39.37 74.3513)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
			(color 0 0 0 1)
		)
		(fill
			(type color)
			(color 255 255 194 1)
		)
		(effects
			(font
				(size 1 1)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "d03881c9-2f05-49f4-8be4-b9b2919c3072")
	)
	(text_box "HV ACCU VOLTAGE DIVIDER / 0...800 V\n\nR_TOP = R2004 + R2005\nR_TOP = 4.7 MOhm + 4.7 MOhm = 9.4 MOhm\n\nR_SNS = R2006 = 26.1 kOhm\n\nk_DIV = R_SNS / (R_TOP + R_SNS)\nk_DIV = 26.1 k / (9.4 M + 26.1 k)\nk_DIV = 0.00276891 = 1 / 361.153\n\nV_INP = V_HV * k_DIV\n\nV_INP @ 588 V = 1.628 V\nV_INP @ 800 V = 2.215 V\n\nAMC0311R linear input max = 2.25 V\n=> linear HV range max = 812.6 V\n\nAMC0311R clipping input = 2.56 V\n=> HV clipping approx. 924.6 V"
		(exclude_from_sim no)
