	(text_box "V_VEHI/V_ACCU RC low pass:\n\nR = 10 kOhm\nC = 100 nF\n\ntau = R * C = 10 kOhm * 100 nF = 1.0 ms\n\nf_c = 1 / (2 * pi * R * C)\nf_c = 1 / (2 * pi * 10 kOhm * 100 nF)\nf_c = 159 Hz\n\nEAOUT2 drive check:\nI_peak ~= 5 V / 10 kOhm = 0.5 mA\n=> OK"
		(exclude_from_sim no)
		(at 142.24 78.4269 0)
