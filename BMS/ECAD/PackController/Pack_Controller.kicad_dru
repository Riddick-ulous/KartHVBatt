(version 1)
(rule "HV800 separation"
	(constraint clearance (min 5mm))
	(condition "A.hasNetclass('HV800') && !(B.Pin_Type == 'Unconnected' || B.Pin_Type == '*+no_connect')")
)
(rule "HV400 separation"
	(constraint clearance (min 3mm))
	(condition "A.hasNetclass('HV400') && (B.hasNetclass('HV400') || B.hasNetclass('HV0')) && !(B.Pin_Type == 'Unconnected' || B.Pin_Type == '*+no_connect')")
)
(rule "HV0 separation"
	(constraint clearance (min 5mm))
	(condition "(A.hasNetclass('HV400') || A.hasNetclass('HV0')) && !(B.hasNetclass('HV800') || B.hasNetclass('HV400') || B.hasNetclass('HV0')) && !(B.Pin_Type == 'Unconnected' || B.Pin_Type == '*+no_connect')")
)
(rule "VEHI local domain exception"
	(constraint clearance (min 0.2mm))
	(condition "(A.hasNetclass('LOCAL_P_VEHI') && B.hasNetclass('LOCAL_P_VEHI')) || (A.hasNetclass('P_VEHI_+5') && B.hasNetclass('P_VEHI_+5'))")
)
(rule "DCDC local domain exception"
	(constraint clearance (min 0.2mm))
	(condition "(A.hasNetclass('LOCAL_P_DCDC') && B.hasNetclass('LOCAL_P_DCDC')) || (A.hasNetclass('P_DCDC_+5') && B.hasNetclass('P_DCDC_+5'))")
)
(rule "ISO UART local spacing"
	(constraint clearance (min 0.2mm))
	(condition "A.hasNetclass('LOCAL_ISO_UART') && B.hasNetclass('LOCAL_ISO_UART')")
)
(rule "Globaler Pad-Freiraum 0,15 mm"
    (constraint clearance (min 0.15mm))
    (condition "A.Type == 'Pad' || B.Type == 'Pad'")
)
(rule "Courtyard-Überlappung bis 0,1 mm zulassen"
    (constraint courtyard_clearance (min -0.1mm))
)