		(uuid "ecb07646-1625-48fd-b0be-0db96cd6582a")
	)
	(text_box "HV ACCU VOLTAGE DIVIDER / 0...800 V\n\nR_TOP = R2004 + R2005\nR_TOP = 4.7 MOhm + 4.7 MOhm = 9.4 MOhm\n\nR_SNS = R2006 = 26.1 kOhm\n\nk_DIV = R_SNS / (R_TOP + R_SNS)\nk_DIV = 26.1 k / (9.4 M + 26.1 k)\nk_DIV = 0.00276891 = 1 / 361.153\n\nV_INP = V_HV * k_DIV\n\nV_INP @ 588 V = 1.628 V\nV_INP @ 800 V = 2.215 V\n\nAMC0311R linear input max = 2.25 V\n=> linear HV range max = 812.6 V\n\nAMC0311R clipping input = 2.56 V\n=> HV clipping approx. 924.6 V"
		(exclude_from_sim no)
		(at 44.45 27.4474 0)
		(size 36.83 37.3226)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
			(color 0 0 0 1)
		)
		(fill
			(type color)
			(color 255 255 194 1)
		)
		(effects
			(font
				(size 1 1)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "32fca835-2fe5-4d51-9f3f-f76c11935fc5")
	)
	(text_box "AMC0311R TRANSFER FUNCTION\n\nV_REFIN = 3.3 V\nV_CLIP  = 2.56 V\n\nG_AMC = V_REFIN / V_CLIP\nG_AMC = 3.3 V / 2.56 V\nG_AMC = 1.28906 V/V\n\nV_OUT = V_INP * G_AMC\nV_OUT = V_HV * k_DIV * G_AMC\n\nV_OUT = V_HV * 0.00356929\nV_OUT = V_HV / 280.167\n\nV_HV = V_OUT * 280.167\n\nV_OUT @ 40 V  = 0.143 V\nV_OUT @ 588 V = 2.099 V\nV_OUT @ 800 V = 2.855 V\n\n12-BIT ADC CONVERSION\n\nREFIN and ADC reference use the same 3.3 V rail.\n\nV_HV = ADC_CODE * V_CLIP\n       / (4095 * k_DIV)\n\nV_HV = ADC_CODE * 0.22578 V/count\n\nADC_CODE @ 588 V approx. 2604\nADC_CODE @ 800 V approx. 3543"
		(exclude_from_sim no)
		(at 132.08 25.4 0)
		(size 39.37 55.032)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
			(color 0 0 0 1)
		)
		(fill
			(type color)
			(color 255 255 194 1)
		)
		(effects
			(font
				(size 1 1)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "330e5fc0-2904-4f0c-a389-94cb4a8975c2")
	)
	(text_box "AMC INPUT LOW-PASS\n\nR_TH = R_TOP || R_SNS\nR_TH = 9.4 MOhm || 26.1 kOhm\nR_TH approx. 26.03 kOhm\n\nC_IN = C2004 = 100 pF\n\ntau_IN = R_TH * C_IN\ntau_IN approx. 2.60 us\n\nf_c,IN = 1 / (2 * pi * R_TH * C_IN)\nf_c,IN approx. 61.1 kHz\n\nt_10-90,IN approx. 2.2 * tau_IN\nt_10-90,IN approx. 5.7 us\n\nAMC OUTPUT / ADC LOW-PASS\n\nR_OUT = R2008 = 1.0 kOhm\nC_OUT = C2014 = 1.0 nF\n\ntau_OUT = R_OUT * C_OUT\ntau_OUT = 1.0 us\n\nf_c,OUT = 1 / (2 * pi * R_OUT * C_OUT)\nf_c,OUT approx. 159 kHz\n\nt_10-90,OUT approx. 2.2 * tau_OUT\nt_10-90,OUT approx. 2.2 us"
		(exclude_from_sim no)
		(at 199.39 93.98 0)
		(size 39.37 50.2022)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
			(color 0 0 0 1)
		)
		(fill
			(type color)
			(color 255 255 194 1)
		)
		(effects
			(font
				(size 1 1)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "8cad0fe0-cbcb-4833-a92b-b6878a63637a")
	)
