	(text_box "Q1902 Gate-Ladung:\n\nIPD95R750P7:\nQg,total,typ = 23nC @ V_GS = 0...10V\nCiss,typ = 712pF\n\nU1901 Ausgangsstromreserve:\nIC_U1901,min ~= 8.2mA\nStatischer Laststrom durch R1903 + U1902 ~= 3.2mA\nVerbleibender Gate-Ladestrom > 5mA\n\nt_gate_on ~= Qg / I_gate\nt_gate_on ~= 23nC / 5mA = 4.6us\n\n=> Gate-Ladung ist gegenueber dem 20...36ms\n   LV-RC-Delay vernachlaessigbar.\n=> Einschaltzeit wird durch R1909/C1901/C1902/C1907\n   und U1904 bestimmt, nicht durch Q1902-Gate."
		(exclude_from_sim no)
		(at 176.53 17.78 0)
		(size 46.99 31.75)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
			(color 0 0 0 1)
		)
		(fill
			(type color)
			(color 255 255 194 1)
		)
		(effects
			(font
				(size 1 1)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "14576963-ce2d-4bd0-8244-a7a7858fd04f")
	)
	(text_box "Q1902 Ausschalten:\n\nD1901 entlaedt den RC-Knoten bei DCDC_AIR_Enable = LOW\nschnell unter V_T- von U1904.\nU1904 schaltet zurueck, U1901 LED geht aus.\nQ1902 Gate entlaedt ueber R1903.\n\nKonservative Gate-Entladung:\nQg,total,typ = 23nC\nR1903 = 100k\nI_discharge,start ~= 4.7V / 100k = 47uA\n\nt_gate_off ~= Qg / I_discharge\nt_gate_off ~= 23nC / 47uA = 0.49ms\n\nZusatzcheck ueber Ciss:\ntau_gate = R1903 * Ciss\ntau_gate = 100k * 712pF = 0.071ms\n\n=> Q1902-OFF typisch deutlich < 1ms.\n=> Q1902 schaltet vor dem mechanischen Oeffnen von K1901 ab."
		(exclude_from_sim no)
		(at 226.06 16.3573 0)
		(size 54.61 35.7127)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
			(color 0 0 0 1)
		)
		(fill
			(type color)
			(color 255 255 194 1)
		)
		(effects
			(font
				(size 1 1)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "2192f6a3-d540-460c-a27b-f0bd0d9a46f3")
	)
	(text_box "K1901 Hold-Time / Abschaltsequenz:\n\nK1901 = KT12-1A-40L-THT\nR_coil = 475R\nC1906 = 10uF\nWorst case: C_min = 8uF (-20%)\nV_i = 12V\nV_release konservativ = 1.4V\n\ntau_hold = R_coil * C_min\ntau_hold = 475R * 8uF = 3.80ms\n\nt_hold = -tau_hold * ln(V_release / V_i)\nt_hold = -3.80ms * ln(1.4V / 12V)\nt_hold = 8.16ms\n\nAbschalten:\n1. DCDC_AIR_Enable = LOW\n2. Q1902 Gate wird in <1ms entladen\n3. K1901 bleibt durch C1906 noch ca. 8ms gehalten\n4. K1901 oeffnet erst nach Q1902-OFF\n\n=> K1901 oeffnet nicht unter vollem DCDC-Strom,\n   sondern erst nachdem Q1902 abgeschaltet hat."
		(exclude_from_sim no)
		(at 130.81 13.97 0)
		(size 43.18 40.64)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
			(color 0 0 0 1)
		)
		(fill
			(type color)
			(color 255 255 194 1)
		)
		(effects
			(font
				(size 1 1)
				(color 0 0 0 1)
			)
			(justify left top)
		)
		(uuid "4a1580ca-e115-40f4-a98b-321d87d5bb48")
	)
