	)
	(text_box "Haltezeit Relais K1\n\nR_coil = 475 Ω\nC_hold = 10 µF, -20% worst-case -> C_min = 8 µF\n\nVi = 12 V\nVt = 1.4 V conservative release threshold\n\ntau = R_coil * C_min\ntau = 475 Ω * 8 µF\ntau = 3.80 ms\n\nt_hold = -tau * ln(Vt / Vi)\nt_hold = -3.80 ms * ln(1.4 V / 12 V)\nt_hold ≈ 8.16 ms"
		(exclude_from_sim no)
		(at 111.76 166.0569 0)
