	(text_box "Haltezeit Relais K1\n\nR = 80Ohm\nC = 47uF (20%) min = 37,6uF\ntau = 3,008ms\nVt = 0,55V (Drop Out KTL12)\nVi = 5V\n\ntau = -R*C*ln(Vt/Vi)\ntau = -3,008ms*ln(0,55V/5V)\ntau = -3,008ms * -2,207\nt = 6,64ms\n\nQ6_t_off = 4,8ms"
		(exclude_from_sim no)
