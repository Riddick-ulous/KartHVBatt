	(text_box "Q1102 DC rating:\nI_D,cont = 0.8A @ 25°C\n\nPrecharge initial current:\n0.8A nominal at 800V\n1.14A worst-case with -30% PTC tolerance"
		(exclude_from_sim no)
		(at 88.9 16.51 0)
		(size 60.96 11.5635)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
