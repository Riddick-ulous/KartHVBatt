	(text_box "ERROR = !(AIR_P_ACT == AIR_P_INT) or !(AIR_N_ACT ==  AIR_N_INT) or  !(PCHRG_ACT ==  AIR_N_INT) or (!DANGER_V and AIR_N_ACT and (PCHRG_ACT or AIR_P_ACT)) or AIR_ERROR\n\nTS_ON = AIR_P_ACT or AIR_N_ACT or PCHRG_ACT or DANGER_V\n\nGREEN = !(TS_ON or ERROR_LATCH)"
