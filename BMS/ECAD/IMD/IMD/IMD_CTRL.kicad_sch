	(text_box "MIT POR setzen\n1 cyklus mit selftest"
		(exclude_from_sim no)
		(at 90.17 143.51 0)
		(size 22.86 6.35)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
